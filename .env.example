# Copier vers .env à la racine du projet (non versionné)

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Email (Resend) — domaine vérifié : urbanize.site (DKIM + SPF sur send.urbanize.site)
RESEND_API_KEY=
EMAIL_FROM=Urbyn <noreply@urbanize.site>

# Admin (interface /admin/login)
ADMIN_ID=
ADMIN_PWD=

# Optionnel
APP_ENV=development

# ── Google Sheets (NOUVEAU — vent / totem) ────────────────────────────────────
# Partage la sheet en Éditeur avec : urbyn-secu-drive@….iam.gserviceaccount.com
# Credentials : laisse vide si GOOGLE_SERVICE_ACCOUNT_JSON (Drive) est déjà set.
#
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=
# Dropdown Région (fusion B10:C10 → écrire B10)
GOOGLE_SHEETS_WRITE_CELL_1=B10
# Dropdown Catégorie Terrain (fusion B11:C11 → écrire B11)
GOOGLE_SHEETS_WRITE_CELL_2=B11
# Ligne titres produits → chercher le totem sélectionné
GOOGLE_SHEETS_LOOKUP_HEADER_RANGE=B21:P21
# Ligne valeurs → même colonne que le match header
GOOGLE_SHEETS_LOOKUP_VALUE_RANGE=B46:P46
# Attente recalcul formules après écriture (ms)
GOOGLE_SHEETS_SETTLE_MS=1500
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
